<%- include('partials/head', { title: 'Student Details' }) %>
<%- include('partials/nav') %>

<div class="container my-5">
  <div class="card mx-auto shadow-lg" style="max-width:900px; border-radius:1rem;">
    <div class="card-header bg-gradient-primary text-white">
      <h3 class="mb-0">
        <i class="bi bi-person-badge-fill me-2"></i><%= student.name %>
      </h3>
    </div>
    <div class="card-body p-4">
      <div class="row gx-4 gy-4 align-items-stretch">
        <!-- Personal Info -->
        <div class="col-md-6">
          <div class="p-3 border rounded bg-light h-100 d-flex flex-column">
            <h5 class="text-primary mb-3">
              <i class="bi bi-info-circle-fill me-1"></i> Personal Info
            </h5>
            <dl class="row mb-0 flex-grow-1">
              <dt class="col-4">Roll Number</dt>
              <dd class="col-8"><%= student.rollNumber %></dd>

              <dt class="col-4">Class</dt>
              <dd class="col-8"><%= student.className %></dd>

              <dt class="col-4">Section</dt>
              <dd class="col-8"><%= student.section || '—' %></dd>

              <dt class="col-4">Gender</dt>
              <dd class="col-8"><%= student.gender || '—' %></dd>

              <dt class="col-4">DOB</dt>
              <dd class="col-8"><%= student.dob ? student.dob.toLocaleDateString() : '—' %></dd>

              <dt class="col-4">Admission</dt>
              <dd class="col-8"><%= student.admissionDate ? student.admissionDate.toLocaleDateString() : '—' %></dd>
            </dl>
          </div>
        </div>

        <!-- Contact Info -->
        <div class="col-md-6">
          <div class="p-3 border rounded bg-light h-100 d-flex flex-column">
            <h5 class="text-primary mb-3">
              <i class="bi bi-telephone-fill me-1"></i> Contact Info
            </h5>
            <dl class="row mb-0 flex-grow-1">
              <dt class="col-4">Phone</dt>
              <dd class="col-8"><%= student.phone || '—' %></dd>

              <dt class="col-4">Email</dt>
              <dd class="col-8"><%= student.email || '—' %></dd>

              <dt class="col-4">Address</dt>
              <dd class="col-8"><%= student.address || '—' %></dd>
            </dl>
          </div>
        </div>

        <!-- Guardian Info -->
        <div class="col-md-6">
          <div class="p-3 border rounded bg-light h-100 d-flex flex-column">
            <h5 class="text-primary mb-3">
              <i class="bi bi-people-fill me-1"></i> Guardian Info
            </h5>
            <dl class="row mb-0 flex-grow-1">
              <dt class="col-4">Father</dt>
              <dd class="col-8"><%= student.guardian?.fatherName || '—' %></dd>

              <dt class="col-4">Mother</dt>
              <dd class="col-8"><%= student.guardian?.motherName || '—' %></dd>

              <dt class="col-4">Contact</dt>
              <dd class="col-8"><%= student.guardian?.contact || '—' %></dd>
            </dl>
          </div>
        </div>

        <!-- Meta Info -->
        <div class="col-md-6">
          <div class="p-3 border rounded bg-light h-100 d-flex flex-column">
            <h5 class="text-primary mb-3">
              <i class="bi bi-clock-history me-1"></i> Timestamps
            </h5>
            <dl class="row mb-0 flex-grow-1">
              <dt class="col-5">Created At</dt>
              <dd class="col-7"><%= student.createdAt.toLocaleString() %></dd>

              <dt class="col-5">Last Updated</dt>
              <dd class="col-7"><%= student.updatedAt.toLocaleString() %></dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <div class="card-footer text-center bg-white">
      <a href="/students/edit/<%= student._id %>" class="btn btn-warning me-2">
        <i class="bi bi-pencil-square me-1"></i> Edit
      </a>
      <a href="javascript:history.back()" class="btn btn-secondary">
        <i class="bi bi-arrow-left-circle me-1"></i> Back
      </a>
    </div>
  </div>
</div>

</body>
</html>
