<%- include('partials/head',{ title:'Change Password' }) %>
<%- include('partials/nav') %>

<div class="container my-5" style="max-width:500px;">
  <h2>Change Password</h2>
  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>
  <% if (success) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>
  <form action="/change-password" method="POST">
    <div class="mb-3">
      <label class="form-label">Old Password</label>
      <input name="oldPassword" type="password" class="form-control" required>
    </div>
    <div class="mb-3">
      <label class="form-label">New Password</label>
      <input name="newPassword" type="password" class="form-control" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Confirm New Password</label>
      <input name="confirm" type="password" class="form-control" required>
    </div>
    <button class="btn btn-primary">Update Password</button>
  </form>
</div>
</body>
</html>
