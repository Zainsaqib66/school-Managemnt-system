<%- include('partials/head', { title: 'Students in ' + className + ' › ' + sectionName }) %>
<%- include('partials/nav') %>

<div class="container my-5">
  <div class="card mx-auto shadow" style="max-width:900px; border-radius:1rem; background:#fff;">
    <div class="card-body p-4">

      <!-- Header, total count, and Add button -->
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h3 class="mb-1">Class: <%= className %> › Section: <%= sectionName %></h3>
          <small class="text-muted"><%= students.length %> student<%= students.length === 1 ? '' : 's' %></small>
        </div>
        <a
          href="/students/add?className=<%= encodeURIComponent(className) %>&section=<%= encodeURIComponent(sectionName) %>"
          class="btn btn-primary"
        >
          <i class="bi bi-person-plus-fill me-1"></i> Add Student
        </a>
      </div>

      <!-- Search input -->
      <div class="mb-3">
        <input
          id="studentSearch"
          type="text"
          class="form-control"
          placeholder="Search students by name or roll…"
        />
      </div>

      <!-- Students Table -->
      <% if (students.length === 0) { %>
        <p class="text-center text-muted">No students in this section.</p>
      <% } else { %>
        <table id="studentsTable" class="table table-striped table-hover text-center">
          <thead class="table-light">
            <tr>
              <th>#</th>
              <th>Name</th>
              <th>Roll #</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% students.forEach((s, i) => { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><%= s.name %></td>
                <td><%= s.rollNumber %></td>
                <td>
                  <a href="/students/view/<%= s._id %>" class="btn btn-sm btn-info me-1">
                    <i class="bi bi-eye-fill me-1"></i> View
                  </a>
                  <a href="/students/edit/<%= s._id %>" class="btn btn-sm btn-warning me-1">
                    <i class="bi bi-pencil-square me-1"></i> Edit
                  </a>
                  <form action="/students/delete/<%= s._id %>" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-danger">
                      <i class="bi bi-trash-fill me-1"></i> Delete
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>

      <a
        href="/classes/<%= encodeURIComponent(className) %>/sections"
        class="btn btn-outline-secondary mt-3"
      >
        <i class="bi bi-arrow-left-circle me-1"></i> Back to Sections
      </a>

    </div>
  </div>
</div>

<script>
  // Live-search filter on the students table
  document.getElementById('studentSearch').addEventListener('input', function() {
    const term = this.value.toLowerCase();
    const rows = document.getElementById('studentsTable').tBodies[0].rows;
    for (let row of rows) {
      const name = row.cells[1].textContent.toLowerCase();
      const roll = row.cells[2].textContent.toLowerCase();
      row.style.display = (name.includes(term) || roll.includes(term)) ? '' : 'none';
    }
  });
</script>

</body>
</html>
