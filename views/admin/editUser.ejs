<%- include('../partials/head', { title: 'Edit User' }) %>
<%- include('../partials/nav') %>

<div class="container my-5" style="max-width: 500px;">
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
  <form action="/admin/users/edit/<%= user._id %>" method="POST">
    <div class="mb-3">
      <label class="form-label">Name</label>
      <input name="name" class="form-control" value="<%= user.name %>" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Email</label>
      <input name="email" type="email" class="form-control" value="<%= user.email %>" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Username</label>
      <input name="username" class="form-control" value="<%= user.username %>" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Role</label>
      <select name="role" id="roleSel" class="form-select" required>
        <% roles.forEach(r => { %>
          <option value="<%= r %>" <%= user.role === r ? 'selected' : '' %>><%= r %></option>
        <% }) %>
      </select>
    </div>
    <div class="mb-3" id="teacherFields" style="<%= user.role === 'teacher' ? '' : 'display:none' %>">
      <label class="form-label">Subject</label>
      <input name="subject" class="form-control" value="<%= user.subject || '' %>">
      <label class="form-label mt-2">Class</label>
      <select name="className" class="form-select">
        <option value="">-- none --</option>
        <% classes.forEach(c => { %>
          <option value="<%= c.name %>" <%= user.className === c.name ? 'selected' : '' %>><%= c.name %></option>
        <% }) %>
      </select>
    </div>
    <button class="btn btn-warning">Update User</button>
    <a href="/admin/users" class="btn btn-secondary ms-2">Cancel</a>
  </form>
</div>

<script>
  const roleSel = document.getElementById('roleSel');
  const teacherFields = document.getElementById('teacherFields');
  roleSel.addEventListener('change', e => {
    teacherFields.style.display = e.target.value === 'teacher' ? '' : 'none';
  });
</script>

</body>
</html>
