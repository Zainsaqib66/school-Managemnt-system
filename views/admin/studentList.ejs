<%- include('../partials/head', { title: 'All Students' }) %>
<%- include('../partials/nav') %>

<div class="container my-5">
  <div class="card shadow rounded-4">
    <div class="card-body p-4">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-mortarboard-fill me-2"></i>All Students</h2>
        <a href="/admin/students/add" class="btn btn-primary btn-sm d-flex gap-1 align-items-center">
          <i class="bi bi-plus-circle-fill"></i> Add Student
        </a>
      </div>

      <% if (students.length === 0) { %>
        <p class="text-center text-muted py-5">No students found.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-striped table-hover align-middle text-center mb-0">
            <thead class="table-dark">
              <tr>
                <th>#</th><th>Name</th><th>Roll #</th><th>Class</th>
                <th>Email</th><th>Phone</th><th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% students.forEach((s,i)=>{ %>
                <tr>
                  <td><%= i+1 %></td>
                  <td><%= s.name %></td>
                  <td><%= s.rollNumber %></td>
                  <td><%= s.className %></td>
                  <td><%= s.email %></td>
                  <td><%= s.phone %></td>
                  <td class="d-flex justify-content-center gap-1">
                    <a href="/admin/students/view/<%= s._id %>"
                       class="btn btn-info btn-sm d-flex align-items-center gap-1">
                      <i class="bi bi-eye-fill"></i> View
                    </a>
                    <a href="/admin/students/edit/<%= s._id %>"
                       class="btn btn-warning btn-sm d-flex align-items-center gap-1">
                      <i class="bi bi-pencil-fill"></i> Edit
                    </a>
                    <button
                      class="btn btn-danger btn-sm d-flex align-items-center gap-1"
                      data-bs-toggle="modal"
                      data-bs-target="#deleteStudentModal"
                      data-id="<%= s._id %>"
                      data-name="<%= s.name %>">
                      <i class="bi bi-trash-fill"></i> Delete
                    </button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>

      <div class="mt-4 text-center">
        <a href="/admin" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
          <i class="bi bi-arrow-left-circle"></i> Back
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Delete Student Modal -->
<div class="modal fade" id="deleteStudentModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <form id="deleteStudentForm" method="POST" class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Delete</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        Are you sure you want to delete <strong id="studentToDelete"></strong>?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger btn-sm">Yes, Delete</button>
      </div>
    </form>
  </div>
</div>

<script>
  document.getElementById('deleteStudentModal').addEventListener('show.bs.modal', function(evt) {
    const btn  = evt.relatedTarget;
    const id   = btn.getAttribute('data-id');
    const name = btn.getAttribute('data-name');
    document.getElementById('studentToDelete').textContent = name;
    document.getElementById('deleteStudentForm').action     = `/admin/students/delete/${id}`;
  });
</script>

<%- include('../partials/footer') %>
