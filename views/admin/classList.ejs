<%- include('../partials/head', { title: 'All Classes' }) %>
<%- include('../partials/nav') %>

<div class="container my-5">
  <div class="card shadow rounded-4">
    <div class="card-body d-flex justify-content-between align-items-center p-4">
      <h2><i class="bi bi-journals me-2"></i>All Classes</h2>
      <a href="/admin/classes/add" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-circle me-1"></i> Add Class
      </a>
    </div>

    <div class="table-responsive">
      <table class="table table-hover text-center mb-0">
        <thead class="table-dark">
          <tr>
            <th>Class Name</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% classes.forEach(cls => { %>
            <tr>
              <td><%= cls.name %></td>
              <td class="d-flex justify-content-center gap-2">
                <a href="/admin/classes/<%= cls._id %>/sections"
                   class="btn btn-sm btn-outline-secondary">
                  <i class="bi bi-grid-fill me-1"></i> Sections
                </a>
                <button
                  class="btn btn-sm btn-outline-warning"
                  data-bs-toggle="modal"
                  data-bs-target="#editClassModal"
                  onclick="populateClassModal('<%= cls._id %>', '<%= cls.name %>')">
                  <i class="bi bi-pencil-fill me-1"></i> Edit
                </button>
                <button
                  class="btn btn-sm btn-outline-danger"
                  data-bs-toggle="modal"
                  data-bs-target="#deleteClassModal"
                  onclick="prepareClassDelete('<%= cls._id %>')">
                  <i class="bi bi-trash-fill me-1"></i> Delete
                </button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="p-4 text-center">
      <a href="/admin" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left-circle me-1"></i> Back
      </a>
    </div>
  </div>
</div>

<!-- Edit Class Modal -->
<div class="modal fade" id="editClassModal" tabindex="-1">
  <div class="modal-dialog">
    <form id="editClassForm" method="POST" class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Edit Class</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input name="name" id="editClassName" class="form-control" required>
      </div>
      <div class="modal-footer">
        <button class="btn btn-warning btn-sm">
          <i class="bi bi-pencil-fill me-1"></i> Update
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Delete Class Modal -->
<div class="modal fade" id="deleteClassModal" tabindex="-1">
  <div class="modal-dialog">
    <form id="deleteClassForm" method="POST" class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title text-danger">Delete Class</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        Are you sure you want to delete this class?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
          <i class="bi bi-x-circle me-1"></i> Cancel
        </button>
        <button class="btn btn-danger btn-sm">
          <i class="bi bi-trash-fill me-1"></i> Yes, Delete
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function populateClassModal(id, name) {
    document.getElementById('editClassName').value = name;
    document.getElementById('editClassForm').action = `/admin/classes/edit/${id}`;
  }
  function prepareClassDelete(id) {
    document.getElementById('deleteClassForm').action = `/admin/classes/delete/${id}`;
  }
</script>

<%- include('../partials/footer') %>
