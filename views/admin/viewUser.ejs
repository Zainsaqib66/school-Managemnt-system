<%- include('../partials/head', { title: 'View User' }) %>
<%- include('../partials/nav') %>

<div class="container my-5" style="max-width: 600px;">
  <h2>User Details</h2>
  <dl class="row">
    <dt class="col-4">Name</dt><dd class="col-8"><%= user.name %></dd>
    <dt class="col-4">Email</dt><dd class="col-8"><%= user.email %></dd>
    <dt class="col-4">Username</dt><dd class="col-8"><%= user.username %></dd>
    <dt class="col-4">Role</dt><dd class="col-8"><%= user.role %></dd>
    <% if (user.role === 'teacher') { %>
      <dt class="col-4">Subject</dt><dd class="col-8"><%= user.subject %></dd>
      <dt class="col-4">Class</dt><dd class="col-8"><%= user.className %></dd>
    <% } %>
    <dt class="col-4">Created</dt><dd class="col-8"><%= user.createdAt.toLocaleString() %></dd>
  </dl>
  <a href="/admin/users" class="btn btn-secondary">← Back to List</a>
</div>

</body>
</html>
