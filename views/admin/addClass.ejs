<%- include('../partials/head', { title: 'Add Class' }) %>
<%- include('../partials/nav') %>

<div class="container my-5">
  <div class="card mx-auto shadow" style="max-width: 500px; border-radius: 1rem;">
    <div class="card-body p-4">
      <h2 class="text-center mb-4">Add New Class</h2>

      <% if (error) { %>
        <div class="alert alert-danger text-center"><%= error %></div>
      <% } %>

      <form action="/admin/classes/add" method="POST">
        <div class="mb-3">
          <label for="name" class="form-label">Class Name</label>
          <input type="text" id="name" name="name" class="form-control" value="<%= name %>" required>
        </div>
        <div class="d-flex justify-content-between mt-4">
          <button type="submit" class="btn btn-success px-4">Create Class</button>
          <a href="/admin/classes" class="btn btn-outline-secondary px-4">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>

</body>
</html>
