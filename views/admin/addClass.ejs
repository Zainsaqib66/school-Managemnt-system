<%- include('../partials/head', { title: 'Add Class' }) %>
<%- include('../partials/nav') %>

<div class="container my-5" style="max-width: 500px;">
  <h2 class="mb-4"><i class="bi bi-plus-circle me-2"></i>Add New Class</h2>

  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <form action="/admin/classes/create" method="POST">
    <div class="mb-3">
      <label for="name" class="form-label">Class Name</label>
      <input
        type="text"
        id="name"
        name="name"
        class="form-control"
        value="<%= form.name || '' %>"
        placeholder="Enter class name"
        required
      >
    </div>

    <button type="submit" class="btn btn-success">
      <i class="bi bi-check-circle me-1"></i> Create Class
    </button>
    <a href="/admin/classes" class="btn btn-secondary ms-2">
      <i class="bi bi-arrow-left-circle me-1"></i> Cancel
    </a>
  </form>
</div>

<%- include('../partials/footer') %>
