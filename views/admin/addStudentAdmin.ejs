<%- include('../partials/head', { title: 'Add Student' }) %>
<%- include('../partials/nav') %>

<div class="container my-5" style="max-width: 700px;">
  <h2 class="mb-4 text-center">Add New Student</h2>

  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <form action="/admin/students/create" method="POST" novalidate>
    <!-- Name -->
    <div class="mb-3">
      <label class="form-label">Name</label>
      <input name="name" type="text" class="form-control" value="<%= form.name || '' %>" required>
    </div>

    <!-- Roll Number -->
    <div class="mb-3">
      <label class="form-label">Roll Number</label>
      <input name="rollNumber" type="number" class="form-control" value="<%= form.rollNumber || '' %>" required>
    </div>

    <!-- Class -->
    <div class="mb-3">
      <label class="form-label">Class</label>
      <select name="className" class="form-select" required>
        <option value="" disabled selected>Select class…</option>
        <% classes.forEach(c => { %>
          <option value="<%= c.name %>" <%= form.className === c.name ? 'selected' : '' %>>
            <%= c.name %>
          </option>
        <% }) %>
      </select>
    </div>

    <!-- Section -->
    <div class="mb-3">
      <label class="form-label">Section</label>
      <select name="section" class="form-select" required>
        <option value="" disabled selected>Select section…</option>
        <% sections.forEach(s => { %>
          <option value="<%= s._id %>" <%= form.section === s._id ? 'selected' : '' %>>
            <%= s.name %> (Class: <%= s.classId %>)
          </option>
        <% }) %>
      </select>
    </div>

    <!-- Email & Phone -->
    <div class="row">
      <div class="col-md-6 mb-3">
        <label class="form-label">Email</label>
        <input name="email" type="email" class="form-control" value="<%= form.email || '' %>" required>
      </div>
      <div class="col-md-6 mb-3">
        <label class="form-label">Phone</label>
        <input name="phone" type="text" class="form-control" value="<%= form.phone || '' %>" required>
      </div>
    </div>

    <!-- Dates -->
    <div class="row">
      <div class="col-md-6 mb-3">
        <label class="form-label">Date of Birth</label>
        <input name="dob" type="date" class="form-control" value="<%= form.dob || '' %>">
      </div>
      <div class="col-md-6 mb-3">
        <label class="form-label">Admission Date</label>
        <input name="admissionDate" type="date" class="form-control" value="<%= form.admissionDate || '' %>">
      </div>
    </div>

    <!-- Gender -->
    <div class="mb-3">
      <label class="form-label">Gender</label>
      <select name="gender" class="form-select">
        <option value="Male"   <%= form.gender === 'Male' ? 'selected' : '' %>>Male</option>
        <option value="Female" <%= form.gender === 'Female' ? 'selected' : '' %>>Female</option>
      </select>
    </div>

    <!-- Address -->
    <div class="mb-3">
      <label class="form-label">Address</label>
      <textarea name="address" class="form-control" rows="2"><%= form.address || '' %></textarea>
    </div>

    <!-- Guardian -->
    <h5 class="mt-4">Guardian Details</h5>
    <div class="mb-3">
      <label class="form-label">Father Name</label>
      <input name="fatherName" type="text" class="form-control" value="<%= form.fatherName || '' %>">
    </div>
    <div class="mb-3">
      <label class="form-label">Mother Name</label>
      <input name="motherName" type="text" class="form-control" value="<%= form.motherName || '' %>">
    </div>
    <div class="mb-3">
      <label class="form-label">Guardian Contact</label>
      <input name="guardianContact" type="text" class="form-control" value="<%= form.guardianContact || '' %>">
    </div>

    <button type="submit" class="btn btn-success w-100">Add Student</button>
  </form>
</div>

<%- include('../partials/footer') %>
