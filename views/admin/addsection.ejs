<%- include('../partials/head', { title: `Add Section – ${classItem.name}` }) %>
<%- include('../partials/nav') %>

<div class="container my-5" style="max-width: 500px;">
  <h2 class="mb-4">
    <i class="bi bi-layout-text-sidebar me-2"></i>
    Add Section to “<%= classItem.name %>”
  </h2>

  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <form action="/admin/classes/<%= classItem._id %>/sections/create" method="POST">
    <div class="mb-3">
      <label for="name" class="form-label">Section Name</label>
      <input
        type="text"
        id="name"
        name="name"
        class="form-control"
        value="<%= form.name || '' %>"
        placeholder="Enter section name"
        required
      >
    </div>

    <button type="submit" class="btn btn-success">
      <i class="bi bi-check-circle me-1"></i> Create Section
    </button>
    <a href="/admin/classes/<%= classItem._id %>/sections" class="btn btn-secondary ms-2">
      <i class="bi bi-arrow-left-circle me-1"></i> Back
    </a>
  </form>
</div>

<%- include('../partials/footer') %>
