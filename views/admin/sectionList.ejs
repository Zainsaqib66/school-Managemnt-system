<%- include('../partials/head', { title: 'Sections' }) %>
<%- include('../partials/nav') %>

<div class="container my-5">
  <div class="card shadow rounded-4">
    <div class="card-body d-flex justify-content-between align-items-center p-4">
      <h2><i class="bi bi-grid-fill me-2"></i>Sections in <%= classItem.name %></h2>
      <!-- Add Section -->
      <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addSectionModal">
        <i class="bi bi-plus-circle me-1"></i> Add Section
      </button>
    </div>

    <div class="table-responsive">
      <table class="table table-hover text-center mb-0">
        <thead class="table-dark">
          <tr>
            <th>Section Name</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% sections.forEach(sec => { %>
            <tr>
              <td><%= sec.name %></td>
              <td class="d-flex justify-content-center gap-2">
                <!-- View Students -->
                <a href="/admin/sections/<%= sec._id %>/students"
                   class="btn btn-sm btn-outline-secondary">
                  <i class="bi bi-people-fill"></i>
                </a>
                <!-- Edit Section -->
                <button
                  class="btn btn-sm btn-outline-warning"
                  data-bs-toggle="modal"
                  data-bs-target="#editSectionModal"
                  onclick="populateSectionModal('<%= sec._id %>', '<%= sec.name %>')">
                  <i class="bi bi-pencil-fill"></i>
                </button>
                <!-- Delete Section -->
                <button
                  class="btn btn-sm btn-outline-danger"
                  data-bs-toggle="modal"
                  data-bs-target="#deleteSectionModal"
                  onclick="prepareSectionDelete('<%= sec._id %>')">
                  <i class="bi bi-trash-fill"></i>
                </button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="p-4 text-center">
      <a href="/admin/classes" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left-circle"></i> Back to Classes
      </a>
    </div>
  </div>
</div>

<!-- Add Section Modal -->
<div class="modal fade" id="addSectionModal" tabindex="-1">
  <div class="modal-dialog">
    <form action="/admin/classes/<%= classItem._id %>/sections/create" method="POST" class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add New Section</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input name="name" type="text" class="form-control" placeholder="Section name" required>
      </div>
      <div class="modal-footer">
        <button class="btn btn-primary btn-sm">Add Section</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Section Modal -->
<div class="modal fade" id="editSectionModal" tabindex="-1">
  <div class="modal-dialog">
    <form id="editSectionForm" method="POST" class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Edit Section</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input name="name" id="editSectionName" class="form-control" required>
      </div>
      <div class="modal-footer">
        <button class="btn btn-warning btn-sm">Update</button>
      </div>
    </form>
  </div>
</div>

<!-- Delete Section Modal -->
<div class="modal fade" id="deleteSectionModal" tabindex="-1">
  <div class="modal-dialog">
    <form id="deleteSectionForm" method="POST" class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title text-danger">Delete Section</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        Are you sure you want to delete this section?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-danger btn-sm">Yes, Delete</button>
      </div>
    </form>
  </div>
</div>

<script>
  function populateSectionModal(id, name) {
    document.getElementById('editSectionName').value = name;
    document.getElementById('editSectionForm').action = `/admin/classes/${'<%= classItem._id %>'}/sections/edit/${id}`;
  }
  function prepareSectionDelete(id) {
    document.getElementById('deleteSectionForm').action = `/admin/classes/${'<%= classItem._id %>'}/sections/delete/${id}`;
  }
</script>

<%- include('../partials/footer') %>
