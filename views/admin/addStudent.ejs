<%- include('../partials/head',{ title:'Add Student' }) %>
<%- include('../partials/nav') %>

<div class="container my-5">
  <div class="card mx-auto shadow-lg" style="max-width:900px; border-radius:1rem;">
    <div class="card-body p-5">
      <h2 class="text-center mb-4">Add New Student</h2>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <form action="/students/add" method="POST" novalidate>
        <!-- Student Info -->
        <fieldset class="border p-3 mb-4 rounded-3">
          <legend class="fw-bold">Student Information</legend>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Name *</label>
              <input name="name" class="form-control" value="<%= student.name||'' %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Roll Number *</label>
              <input name="rollNumber" type="number" class="form-control" value="<%= student.rollNumber||'' %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Class *</label>
              <select name="className" id="classSelect" class="form-select" required>
                <option value="" disabled <%= !student.className?'selected':'' %>>Select class…</option>
                <% classes.forEach(c => { %>
                  <option value="<%=c.name%>" <%= student.className===c.name?'selected':'' %>><%=c.name%></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Section *</label>
              <select name="section" id="sectionSelect" class="form-select" required disabled>
                <option>Select class first…</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Date of Birth</label>
              <input name="dob" type="date" class="form-control" value="<%= student.dob ? student.dob.toISOString().slice(0,10) : '' %>">
            </div>
            <div class="col-md-6">
              <label class="form-label">Admission Date</label>
              <input name="admissionDate" type="date" class="form-control" value="<%= student.admissionDate ? student.admissionDate.toISOString().slice(0,10) : '' %>">
            </div>
            <div class="col-md-6">
              <label class="form-label">Gender</label>
              <select name="gender" class="form-select">
                <option value="" disabled <%= !student.gender?'selected':'' %>>Select…</option>
                <option value="M" <%= student.gender==='M'?'selected':'' %>>Male</option>
                <option value="F" <%= student.gender==='F'?'selected':'' %>>Female</option>
                <option value="Other" <%= student.gender==='Other'?'selected':'' %>>Other</option>
              </select>
            </div>
          </div>
        </fieldset>

        <!-- Contact Info -->
        <fieldset class="border p-3 mb-4 rounded-3">
          <legend class="fw-bold">Contact Information</legend>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Phone</label>
              <input name="phone" type="tel" class="form-control" value="<%= student.phone||'' %>">
            </div>
            <div class="col-md-6">
              <label class="form-label">Email</label>
              <input name="email" type="email" class="form-control" value="<%= student.email||'' %>">
            </div>
            <div class="col-12">
              <label class="form-label">Address</label>
              <input name="address" class="form-control" value="<%= student.address||'' %>">
            </div>
          </div>
        </fieldset>

        <!-- Guardian Info -->
        <fieldset class="border p-3 mb-4 rounded-3">
          <legend class="fw-bold">Guardian Information</legend>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Father’s Name</label>
              <input name="fatherName" class="form-control" value="<%= student.guardian?.fatherName||'' %>">
            </div>
            <div class="col-md-6">
              <label class="form-label">Mother’s Name</label>
              <input name="motherName" class="form-control" value="<%= student.guardian?.motherName||'' %>">
            </div>
            <div class="col-md-6">
              <label class="form-label">Guardian Contact</label>
              <input name="guardianContact" class="form-control" value="<%= student.guardian?.contact||'' %>">
            </div>
          </div>
        </fieldset>

        <div class="text-center mt-4">
          <button class="btn btn-primary px-5">Add Student</button>
          <a href="/students" class="btn btn-outline-secondary px-4 ms-2">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  const classSelect   = document.getElementById('classSelect');
  const sectionSelect = document.getElementById('sectionSelect');

  async function loadSections(cls, sel = '') {
    sectionSelect.disabled = true;
    sectionSelect.innerHTML = '<option>Loading…</option>';
    try {
      const res = await fetch(`/classes/api/${encodeURIComponent(cls)}`);
      const list = await res.json();
      sectionSelect.innerHTML = '<option disabled>Select section…</option>' +
        list.map(n => `<option value="${n}" ${n === sel ? 'selected' : ''}>${n}</option>`).join('');
      sectionSelect.disabled = false;
    } catch {
      sectionSelect.innerHTML = '<option>Error loading</option>';
    }
  }

  classSelect.addEventListener('change', () => {
    if (classSelect.value) loadSections(classSelect.value);
  });

  window.addEventListener('DOMContentLoaded', () => {
    if (classSelect.value) loadSections(classSelect.value, '<%= student.section || "" %>');
  });
</script>

</body>
</html>
