<%- include('partials/head', { title: 'Edit Student' }) %>
<%- include('partials/nav') %>

<div class="container my-5">
  <div class="card mx-auto shadow-lg" style="max-width: 800px; border-radius: 1rem;">
    <div class="card-body p-5">
      <h2 class="text-center mb-4">Edit Student</h2>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <form action="/students/edit/<%= student._id %>" method="POST" novalidate>

        <!-- Section: Student Info -->
        <h5 class="mb-3 text-primary border-bottom pb-2">Student Info</h5>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Name <span class="text-danger">*</span></label>
            <input name="name" class="form-control" value="<%= student.name %>" required>
          </div>
          <div class="col-md-6">
            <label class="form-label">Roll Number <span class="text-danger">*</span></label>
            <input name="rollNumber" type="number" class="form-control" value="<%= student.rollNumber %>" required>
          </div>
          <div class="col-md-6">
            <label class="form-label">Class <span class="text-danger">*</span></label>
            <select name="className" class="form-select" required>
              <% classes.forEach(c => { %>
                <option value="<%= c.name %>" <%= student.className === c.name ? 'selected' : '' %>><%= c.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label">Section</label>
            <input name="section" class="form-control" value="<%= student.section || '' %>">
          </div>
        </div>

        <!-- Date of Birth and Gender -->
        <div class="row g-3 mt-3">
          <div class="col-md-6">
            <label class="form-label">Date of Birth</label>
            <input name="dob" type="date" class="form-control"
              value="<%= student.dob ? student.dob.toISOString().split('T')[0] : '' %>">
          </div>
          <div class="col-md-6">
            <label class="form-label">Gender</label>
            <select name="gender" class="form-select">
              <option value="">Select gender…</option>
              <option value="M" <%= student.gender === 'M' ? 'selected' : '' %>>Male</option>
              <option value="F" <%= student.gender === 'F' ? 'selected' : '' %>>Female</option>
              <option value="Other" <%= student.gender === 'Other' ? 'selected' : '' %>>Other</option>
            </select>
          </div>
        </div>

        <!-- Section: Contact Info -->
        <h5 class="mt-4 mb-3 text-primary border-bottom pb-2">Contact Info</h5>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Phone</label>
            <input name="phone" type="tel" pattern="^[0-9+\-()\s]{7,15}$" class="form-control"
              placeholder="e.g. 0300-1234567" value="<%= student.phone || '' %>">
          </div>
          <div class="col-md-6">
            <label class="form-label">Email</label>
            <input name="email" type="email" class="form-control" value="<%= student.email || '' %>">
          </div>
        </div>
        <div class="mt-3">
          <label class="form-label">Address</label>
          <input name="address" class="form-control" value="<%= student.address || '' %>">
        </div>

        <!-- Section: Guardian Info -->
        <h5 class="mt-4 mb-3 text-primary border-bottom pb-2">Guardian Info</h5>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Father’s Name</label>
            <input name="fatherName" class="form-control" value="<%= student.guardian?.fatherName || '' %>">
          </div>
          <div class="col-md-6">
            <label class="form-label">Mother’s Name</label>
            <input name="motherName" class="form-control" value="<%= student.guardian?.motherName || '' %>">
          </div>
        </div>
        <div class="mt-3">
          <label class="form-label">Guardian Contact</label>
          <input name="guardianContact" class="form-control" type="tel"
            pattern="^[0-9+\-()\s]{7,15}$" placeholder="e.g. 0321-8765432"
            value="<%= student.guardian?.contact || '' %>">
        </div>

        <!-- Submit Buttons -->
        <div class="text-center mt-4">
          <button type="submit" class="btn btn-success px-4">
            <i class="bi bi-check-circle me-1"></i> Update
          </button>
          <a href="/students" class="btn btn-secondary ms-3">
            <i class="bi bi-x-circle me-1"></i> Cancel
          </a>
        </div>

      </form>
    </div>
  </div>
</div>
</body>
</html>
