<%- include('partials/head', { title: 'Sections of ' + className }) %>
<%- include('partials/nav') %>

<div class="container my-5">
  <div class="d-flex justify-content-between mb-4 align-items-center">
    <h2>Class: <%= className %> › Sections</h2>
    <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addSectionModal">
      <i class="bi bi-plus-circle me-1"></i> Add Section
    </button>
  </div>

  <% if (message) { %>
    <div class="alert alert-success alert-dismissible fade show">
      <%= message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show">
      <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <% if (sections.length === 0) { %>
    <p class="text-center text-muted">No sections found.</p>
  <% } else { %>
    <table class="table table-striped table-hover text-center">
      <thead class="table-light">
        <tr>
          <th>#</th>
          <th>Name</th>
          <th>Students</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% sections.forEach(sec => { %>
          <tr>
            <td><%= sec.index %></td>
            <td><%= sec.name %></td>
            <td><%= sec.studentCount %></td>
            <td>
              <a
                href="/classes/<%= encodeURIComponent(className) %>/sections/<%= encodeURIComponent(sec.name) %>"
                class="btn btn-sm btn-primary me-1"
              >
                <i class="bi bi-eye-fill me-1"></i> View
              </a>
              <button
                class="btn btn-sm btn-warning me-1"
                data-bs-toggle="modal"
                data-bs-target="#editSectionModal"
                data-id="<%= sec._id %>"
                data-name="<%= sec.name %>"
              >
                <i class="bi bi-pencil-square me-1"></i> Edit
              </button>
              <button
                class="btn btn-sm btn-danger"
                data-bs-toggle="modal"
                data-bs-target="#deleteSectionModal"
                data-id="<%= sec._id %>"
                data-name="<%= sec.name %>"
              >
                <i class="bi bi-trash-fill me-1"></i> Delete
              </button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<!-- Add Section Modal -->
<div class="modal fade" id="addSectionModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form action="/classes/<%= encodeURIComponent(className) %>/sections/add" method="POST">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Add Section</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input name="name" class="form-control" placeholder="Section Name" required />
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" data-bs-dismiss="modal">
            Cancel
          </button>
          <button type="submit" class="btn btn-success">
            Save
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Edit Section Modal -->
<div class="modal fade" id="editSectionModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form id="editSectionForm" method="POST">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Edit Section</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input name="name" id="editSectionName" class="form-control" required />
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" data-bs-dismiss="modal">
            Cancel
          </button>
          <button type="submit" class="btn btn-warning">
            Update
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Delete Section Modal -->
<div class="modal fade" id="deleteSectionModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form id="deleteSectionForm" method="POST">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Delete Section</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          Are you sure you want to delete <strong id="deleteSectionName"></strong>?
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" data-bs-dismiss="modal">No</button>
          <button type="submit" class="btn btn-danger">Yes, Delete</button>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
  const editSectionModal = document.getElementById('editSectionModal');
  editSectionModal.addEventListener('show.bs.modal', (e) => {
    const btn = e.relatedTarget;
    document.getElementById('editSectionName').value = btn.dataset.name;
    document.getElementById('editSectionForm').action =
      `/classes/<%= encodeURIComponent(className) %>/sections/edit/${btn.dataset.id}`;
  });

  const deleteSectionModal = document.getElementById('deleteSectionModal');
  deleteSectionModal.addEventListener('show.bs.modal', (e) => {
    const btn = e.relatedTarget;
    document.getElementById('deleteSectionName').textContent = btn.dataset.name;
    document.getElementById('deleteSectionForm').action =
      `/classes/<%= encodeURIComponent(className) %>/sections/delete/${btn.dataset.id}`;
  });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
