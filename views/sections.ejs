<%- include('partials/head', { title: 'Sections of ' + className }) %>
<%- include('partials/nav') %>

<div class="container my-5">
  <div class="card mx-auto shadow" style="max-width:800px; border-radius:1rem; background:#fff;">
    <div class="card-body p-4">

      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Class: <%= className %> › Sections</h3>
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addSectionModal">
          <i class="bi bi-plus-circle me-1"></i> Add Section
        </button>
      </div>

      <!-- Alerts -->
      <% if (message) { %>
        <div class="alert alert-success alert-dismissible fade show">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>
      <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show">
          <%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <!-- Sections Table -->
      <% if (sections.length === 0) { %>
        <p class="text-center text-muted">No sections created yet.</p>
      <% } else { %>
        <table class="table table-striped table-hover text-center">
          <thead class="table-light">
            <tr>
              <th>#</th>
              <th>Section Name</th>
              <th>Students</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% sections.forEach(sec => { %>
              <tr>
                <td><%= sec.index %></td>
                <td><%= sec.name %></td>
                <td><%= sec.studentCount %></td>
                <td>
                  <a href="/classes/<%= encodeURIComponent(className) %>/sections/<%= encodeURIComponent(sec.name) %>"
                     class="btn btn-sm btn-primary me-1">
                    <i class="bi bi-eye-fill me-1"></i> View
                  </a>
                  <button class="btn btn-sm btn-warning me-1"
                          data-bs-toggle="modal"
                          data-bs-target="#editSectionModal"
                          data-id="<%= sec._id %>"
                          data-name="<%= sec.name %>">
                    <i class="bi bi-pencil-square me-1"></i> Edit
                  </button>
                  <button class="btn btn-sm btn-danger"
                          data-bs-toggle="modal"
                          data-bs-target="#deleteSectionModal"
                          data-id="<%= sec._id %>"
                          data-name="<%= sec.name %>">
                    <i class="bi bi-trash-fill me-1"></i> Delete
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>

      <a href="/classes" class="btn btn-outline-secondary mt-3">
        <i class="bi bi-arrow-left-circle me-1"></i> Back to Classes
      </a>

    </div>
  </div>
</div>

<!-- Add Section Modal -->
<div class="modal fade" id="addSectionModal" tabindex="-1">
  <div class="modal-dialog">
    <form action="/classes/<%= encodeURIComponent(className) %>/sections/add" method="POST">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-plus-circle me-1"></i> Add Section</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input name="name" class="form-control" placeholder="Section Name" required>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i> Cancel
          </button>
          <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle me-1"></i> Save
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Edit Section Modal -->
<div class="modal fade" id="editSectionModal" tabindex="-1">
  <div class="modal-dialog">
    <form id="editSectionForm" method="POST">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-pencil-square me-1"></i> Edit Section</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input name="name" id="editSectionName" class="form-control" required>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i> Cancel
          </button>
          <button type="submit" class="btn btn-warning">
            <i class="bi bi-pencil-square me-1"></i> Update
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Delete Section Modal -->
<div class="modal fade" id="deleteSectionModal" tabindex="-1">
  <div class="modal-dialog">
    <form id="deleteSectionForm" method="POST">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-trash-fill me-1"></i> Delete Section</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          Are you sure you want to delete <strong id="deleteSectionName"></strong>?
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i> No
          </button>
          <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash-fill me-1"></i> Yes, Delete
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
  const currentClass = '<%= encodeURIComponent(className) %>';

  // Edit Section Modal
  document.getElementById('editSectionModal').addEventListener('show.bs.modal', e => {
    const btn = e.relatedTarget;
    document.getElementById('editSectionName').value = btn.dataset.name;
    document.getElementById('editSectionForm').action =
      `/classes/${currentClass}/sections/edit/${btn.dataset.id}`;
  });

  // Delete Section Modal
  document.getElementById('deleteSectionModal').addEventListener('show.bs.modal', e => {
    const btn = e.relatedTarget;
    document.getElementById('deleteSectionName').textContent = btn.dataset.name;
    document.getElementById('deleteSectionForm').action =
      `/classes/${currentClass}/sections/delete/${btn.dataset.id}`;
  });
</script>

<!-- Auto-dismiss alerts after 3s -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => {
      document.querySelectorAll('.alert').forEach(el => {
        bootstrap.Alert.getOrCreateInstance(el).close();
      });
    }, 3000);
  });
</script>

</body>
</html>
