<%- include('../partials/head', { title: 'Student Details' }) %>
<%- include('../partials/nav') %>

<div class="container my-5" style="max-width: 600px;">
  <h2><i class="bi bi-person-badge-fill me-2"></i><%= student.name %></h2>
  <dl class="row">
    <dt class="col-4">Username</dt>
    <dd class="col-8"><%= student.username %></dd>

    <dt class="col-4">Email</dt>
    <dd class="col-8"><%= student.email %></dd>

    <dt class="col-4">Class</dt>
    <dd class="col-8"><%= student.className || '—' %></dd>

    <dt class="col-4">Roll Number</dt>
    <dd class="col-8"><%= student.rollNumber %></dd>

    <dt class="col-4">Section</dt>
    <dd class="col-8"><%= student.section || '—' %></dd>
  </dl>
  <a href="/students" class="btn btn-secondary mt-3">← Back to List</a>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
