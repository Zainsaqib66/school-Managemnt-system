<%- include('../partials/head', { title: 'Students' }) %>
<%- include('../partials/nav') %>

<div class="container my-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Students</h2>
    <a href="/students/add" class="btn btn-success">
      <i class="bi bi-person-plus-fill me-1"></i> Add Student
    </a>
  </div>

  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>
  <% if (message) { %>
    <div class="alert alert-success"><%= message %></div>
  <% } %>

  <% if (students.length === 0) { %>
    <p class="text-center text-muted">No students found.</p>
  <% } else { %>
    <table class="table table-striped text-center">
      <thead>
        <tr>
          <th>#</th>
          <th>Name</th>
          <th>Roll Number</th>
          <th>Class</th>
          <th>Section</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% students.forEach((s, i) => { %>
          <tr>
            <td><%= i + 1 %></td>
            <td><%= s.name %></td>
            <td><%= s.rollNumber %></td>
            <td><%= s.className %></td>
            <td><%= s.section || '—' %></td>
            <td>
              <a href="/students/view/<%= s._id %>" class="btn btn-sm btn-info me-1">View</a>
              <a href="/students/edit/<%= s._id %>" class="btn btn-sm btn-warning me-1">Edit</a>
              <form
                action="/students/delete/<%= s._id %>"
                method="POST"
                class="d-inline"
                onsubmit="return confirm('Delete this student?');"
              >
                <button class="btn btn-sm btn-danger">Delete</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
