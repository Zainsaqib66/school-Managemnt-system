<%- include('partials/head', { title: 'Add Student' }) %>
<%- include('partials/nav') %>

<div class="container my-5">
  <div class="card mx-auto shadow" style="max-width:900px; border-radius:1rem; background:#fff;">
    <div class="card-body p-5">
      <h2 class="text-center mb-4">Add Student</h2>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <form action="/students/add" method="POST" novalidate>
        <!-- Student Information -->
        <fieldset class="border p-3 mb-4">
          <legend class="w-auto px-2 fs-5 fw-bold">Student Information</legend>
          <div class="row g-3">
            <!-- Name -->
            <div class="col-md-6">
              <label class="form-label fw-bold">Name <span class="text-danger">*</span></label>
              <input
                name="name"
                type="text"
                class="form-control"
                value="<%= student.name||'' %>"
                required
              >
            </div>
            <!-- Roll Number -->
            <div class="col-md-6">
              <label class="form-label fw-bold">Roll Number <span class="text-danger">*</span></label>
              <input
                name="rollNumber"
                type="number"
                class="form-control"
                value="<%= student.rollNumber||'' %>"
                required
              >
            </div>
            <!-- Class -->
            <div class="col-md-6">
              <label class="form-label fw-bold">Class <span class="text-danger">*</span></label>
              <select
                name="className"
                id="classSelect"
                class="form-select"
                required
              >
                <option value="" disabled <%= !student.className ? 'selected' : '' %>>
                  Select class…
                </option>
                <% classes.forEach(c => { %>
                  <option
                    value="<%= c.name %>"
                    <%= student.className === c.name ? 'selected' : '' %>
                  ><%= c.name %></option>
                <% }) %>
              </select>
            </div>
            <!-- Section -->
            <div class="col-md-6">
              <label class="form-label fw-bold">Section <span class="text-danger">*</span></label>
              <select
                name="section"
                id="sectionSelect"
                class="form-select"
                required
                disabled
              >
                <option value="">Select class first…</option>
              </select>
            </div>
            <!-- DOB -->
            <div class="col-md-6">
              <label class="form-label fw-bold">Date of Birth</label>
              <input
                name="dob"
                type="date"
                class="form-control"
                value="<%= student.dob ? student.dob.toISOString().split('T')[0] : '' %>"
              >
            </div>
            <!-- Admission Date -->
            <div class="col-md-6">
              <label class="form-label fw-bold">Admission Date</label>
              <input
                name="admissionDate"
                type="date"
                class="form-control"
                value="<%= student.admissionDate ? student.admissionDate.toISOString().split('T')[0] : '' %>"
              >
            </div>
            <!-- Gender -->
            <div class="col-md-6">
              <label class="form-label fw-bold">Gender</label>
              <select name="gender" class="form-select">
                <option value="" disabled <%= !student.gender ? 'selected' : '' %>>
                  Select gender…
                </option>
                <option value="M" <%= student.gender==='M'?'selected':'' %>>Male</option>
                <option value="F" <%= student.gender==='F'?'selected':'' %>>Female</option>
                <option value="Other" <%= student.gender==='Other'?'selected':'' %>>Other</option>
              </select>
            </div>
          </div>
        </fieldset>

        <!-- Contact Information -->
        <fieldset class="border p-3 mb-4">
          <legend class="w-auto px-2 fs-5 fw-bold">Contact Information</legend>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-bold">Phone</label>
              <input
                name="phone"
                type="tel"
                pattern="[0-9]{10,15}"
                class="form-control"
                value="<%= student.phone||'' %>"
              >
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold">Email</label>
              <input
                name="email"
                type="email"
                class="form-control"
                value="<%= student.email||'' %>"
              >
            </div>
            <div class="col-12">
              <label class="form-label fw-bold">Address</label>
              <input
                name="address"
                type="text"
                class="form-control"
                value="<%= student.address||'' %>"
              >
            </div>
          </div>
        </fieldset>

        <!-- Guardian Information -->
        <fieldset class="border p-3 mb-4">
          <legend class="w-auto px-2 fs-5 fw-bold">Guardian Information</legend>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-bold">Father’s Name</label>
              <input
                name="fatherName"
                type="text"
                class="form-control"
                value="<%= student.guardian?.fatherName||'' %>"
              >
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold">Mother’s Name</label>
              <input
                name="motherName"
                type="text"
                class="form-control"
                value="<%= student.guardian?.motherName||'' %>"
              >
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold">Guardian Contact</label>
              <input
                name="guardianContact"
                type="tel"
                pattern="[0-9]{10,15}"
                class="form-control"
                value="<%= student.guardian?.contact||'' %>"
              >
            </div>
          </div>
        </fieldset>

        <!-- Actions -->
        <div class="text-center mt-4">
          <button type="submit" class="btn btn-primary px-4 me-2">
            <i class="bi bi-person-plus-fill me-1"></i> Add Student
          </button>
          <a href="/students" class="btn btn-secondary px-4">
            <i class="bi bi-x-circle me-1"></i> Cancel
          </a>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  const classSelect   = document.getElementById('classSelect');
  const sectionSelect = document.getElementById('sectionSelect');

  async function loadSections(cls, selected = '') {
    sectionSelect.disabled = true;
    sectionSelect.innerHTML = '<option>Loading…</option>';
    try {
      const res  = await fetch(`/classes/api/${encodeURIComponent(cls)}`);
      const list = await res.json();
      sectionSelect.innerHTML =
        '<option value="" disabled>Select section…</option>' +
        list.map(name => `
          <option value="${name}" ${name===selected?'selected':''}>${name}</option>
        `).join('');
      sectionSelect.disabled = false;
    } catch {
      sectionSelect.innerHTML = '<option>Error loading</option>';
    }
  }

  classSelect.addEventListener('change', () => {
    if (classSelect.value) {
      loadSections(classSelect.value, '<%= student.section||"" %>');
    }
  });

  window.addEventListener('DOMContentLoaded', () => {
    if (classSelect.value) {
      loadSections(classSelect.value, '<%= student.section||"" %>');
    }
  });
</script>

</body>
</html>
