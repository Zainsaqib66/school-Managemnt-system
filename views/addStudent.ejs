<%- include('partials/head', { title: 'Add Student' }) %>
<%- include('partials/nav') %>

<div class="container my-5">
  <div class="card mx-auto shadow-lg" style="max-width:700px; border-radius:1rem;">
    <div class="card-body p-5">
      <h2 class="text-center mb-4">Add Student</h2>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <% const s = (typeof student !== 'undefined' && student) ? student : {}; %>

      <form action="/students/add" method="POST" novalidate>
        <!-- Name -->
        <div class="mb-4">
          <label class="form-label fw-bold">Name</label>
          <input
            name="name"
            type="text"
            class="form-control form-control-lg"
            placeholder="Enter student's full name"
            value="<%= s.name||'' %>"
            required
          >
        </div>

        <!-- Roll Number -->
        <div class="mb-4">
          <label class="form-label fw-bold">Roll Number</label>
          <input
            name="rollNumber"
            type="number"
            class="form-control form-control-lg"
            placeholder="Enter roll number"
            value="<%= s.rollNumber||'' %>"
            required
          >
        </div>

        <!-- Class -->
        <div class="mb-4">
          <label class="form-label fw-bold">Class</label>
          <select
            name="className"
            class="form-control form-control-lg text-dark"
            required
          >
            <option value="" disabled <%= !s.className?'selected':'' %>>
              Select class…
            </option>
            <% classes.forEach(c => { %>
              <option
                value="<%= c.name %>"
                <%= s.className===c.name?'selected':'' %>
              ><%= c.name %></option>
            <% }) %>
          </select>
        </div>

        <!-- Date of Birth -->
        <div class="mb-4">
          <label class="form-label fw-bold">Date of Birth</label>
          <input
            name="dob"
            type="date"
            class="form-control form-control-lg"
            value="<%= s.dob
                      ? s.dob.toISOString().split('T')[0]
                      : '' %>"
          >
        </div>

        <!-- Gender -->
        <div class="mb-4">
          <label class="form-label fw-bold">Gender</label>
          <select
            name="gender"
            class="form-control form-control-lg text-dark"
          >
            <option value="" disabled <%= !s.gender?'selected':'' %>>
              Select gender…
            </option>
            <option value="M" <%= s.gender==='M'?'selected':'' %>>Male</option>
            <option value="F" <%= s.gender==='F'?'selected':'' %>>Female</option>
            <option value="Other" <%= s.gender==='Other'?'selected':'' %>>Other</option>
          </select>
        </div>

        <!-- Address -->
        <div class="mb-4">
          <label class="form-label fw-bold">Address</label>
          <input
            name="address"
            type="text"
            class="form-control form-control-lg"
            placeholder="Enter home address"
            value="<%= s.address||'' %>"
          >
        </div>

        <!-- Phone -->
        <div class="mb-4">
          <label class="form-label fw-bold">Phone</label>
          <input
            name="phone"
            type="tel"
            class="form-control form-control-lg"
            placeholder="Enter phone number"
            value="<%= s.phone||'' %>"
          >
        </div>

        <!-- Email -->
        <div class="mb-4">
          <label class="form-label fw-bold">Email</label>
          <input
            name="email"
            type="email"
            class="form-control form-control-lg"
            placeholder="Enter email address"
            value="<%= s.email||'' %>"
          >
        </div>

        <!-- Guardian Info -->
        <div class="row gx-3 mb-4">
          <div class="col">
            <label class="form-label fw-bold">Father’s Name</label>
            <input
              name="fatherName"
              type="text"
              class="form-control form-control-lg"
              placeholder="Father’s name"
              value="<%= s.guardian?.fatherName||'' %>"
            >
          </div>
          <div class="col">
            <label class="form-label fw-bold">Mother’s Name</label>
            <input
              name="motherName"
              type="text"
              class="form-control form-control-lg"
              placeholder="Mother’s name"
              value="<%= s.guardian?.motherName||'' %>"
            >
          </div>
        </div>

        <div class="mb-4">
          <label class="form-label fw-bold">Guardian Contact</label>
          <input
            name="guardianContact"
            type="tel"
            class="form-control form-control-lg"
            placeholder="Guardian phone number"
            value="<%= s.guardian?.contact||'' %>"
          >
        </div>

        <!-- Admission Date -->
        <div class="mb-4">
          <label class="form-label fw-bold">Admission Date</label>
          <input
            name="admissionDate"
            type="date"
            class="form-control form-control-lg"
            value="<%= s.admissionDate
                      ? s.admissionDate.toISOString().split('T')[0]
                      : '' %>"
          >
        </div>

        <!-- Section -->
        <div class="mb-5">
          <label class="form-label fw-bold">Section</label>
          <input
            name="section"
            type="text"
            class="form-control form-control-lg"
            placeholder="Enter section (e.g. A)"
            value="<%= s.section||'' %>"
          >
        </div>

        <div class="text-center">
          <button type="submit"
                  class="btn btn-primary btn-lg px-5">
            Add Student
          </button>
          <a href="/students"
             class="btn btn-secondary btn-lg px-4 ms-3">
            Cancel
          </a>
        </div>
      </form>
    </div>
  </div>
</div>

</body>
</html>
