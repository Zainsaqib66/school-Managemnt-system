<%- include('../partials/head', { title: 'Manage Classes' }) %>
<%- include('../partials/nav') %>

<div class="container my-5">
  <h2>Manage Classes</h2>
  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>
  <% if (message) { %>
    <div class="alert alert-success"><%= message %></div>
  <% } %>

  <table class="table table-striped">
    <thead>
      <tr>
        <th>#</th>
        <th>Class Name</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% classes.forEach((cls, index) => { %>
        <tr>
          <td><%= index + 1 %></td>
          <td><%= cls.name %></td>
          <td>
            <a href="/admin/classes/edit/<%= cls._id %>" class="btn btn-sm btn-warning">Edit</a>
            <form action="/admin/classes/delete/<%= cls._id %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure?');">
              <button type="submit" class="btn btn-sm btn-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <a href="/admin/classes/add" class="btn btn-success mt-3">Add New Class</a>
</div>

</body>
</html>
