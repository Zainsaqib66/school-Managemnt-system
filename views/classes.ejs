<%- include('partials/head', { title: 'Classes' }) %>
<%- include('partials/nav') %>

<div class="container my-5">
  <div class="card mx-auto shadow" style="max-width:800px; border-radius:1rem; background:#fff;">
    <div class="card-body p-4">

      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>All Classes</h2>
        <button class="btn btn-success me-2" data-bs-toggle="modal" data-bs-target="#addClassModal">
          <i class="bi bi-plus-circle me-1"></i> Add Class
        </button>
      </div>

      <!-- Alerts -->
      <% if (message) { %>
        <div class="alert alert-success alert-dismissible fade show">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>
      <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show">
          <%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <!-- Table -->
      <% if (classes.length === 0) { %>
        <p class="text-center text-muted">No classes found.</p>
      <% } else { %>
        <table class="table table-striped table-hover text-center">
          <thead class="table-light">
            <tr>
              <th>#</th>
              <th>Name</th>
              <th>Students</th>
              <th>Sections</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% classes.forEach(c => { %>
              <tr>
                <td><%= c.index %></td>
                <td><%= c.name %></td>
                <td><%= c.studentCount %></td>
                <td><%= c.sectionCount %></td>
                <td>
                  <a href="/classes/<%= encodeURIComponent(c.name) %>" class="btn btn-sm btn-primary me-1">
                    <i class="bi bi-eye-fill me-1"></i> View
                  </a>
                  <button
                    class="btn btn-sm btn-warning me-1"
                    data-bs-toggle="modal"
                    data-bs-target="#editClassModal"
                    data-id="<%= c._id %>"
                    data-name="<%= c.name %>"
                  >
                    <i class="bi bi-pencil-square me-1"></i> Edit
                  </button>
                  <button
                    class="btn btn-sm btn-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#deleteClassModal"
                    data-id="<%= c._id %>"
                    data-name="<%= c.name %>"
                  >
                    <i class="bi bi-trash-fill me-1"></i> Delete
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>

    </div>
  </div>
</div>

<!-- Add Class Modal -->
<div class="modal fade" id="addClassModal" tabindex="-1">
  <div class="modal-dialog">
    <form action="/classes/add" method="POST">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Add Class</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input name="name" class="form-control" placeholder="Class Name" required>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i> Cancel
          </button>
          <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle me-1"></i> Save
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Edit Class Modal -->
<div class="modal fade" id="editClassModal" tabindex="-1">
  <div class="modal-dialog">
    <form id="editClassForm" method="POST">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Edit Class</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input name="name" id="editClassName" class="form-control" required>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i> Cancel
          </button>
          <button type="submit" class="btn btn-warning">
            <i class="bi bi-pencil-square me-1"></i> Update
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Delete Class Modal -->
<div class="modal fade" id="deleteClassModal" tabindex="-1">
  <div class="modal-dialog">
    <form id="deleteClassForm" method="POST">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Delete Class</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          Are you sure you want to delete <strong id="deleteClassName"></strong>?
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i> No
          </button>
          <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash-fill me-1"></i> Yes, Delete
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
  // Modals wiring
  document.getElementById('editClassModal').addEventListener('show.bs.modal', e => {
    const btn = e.relatedTarget;
    document.getElementById('editClassName').value = btn.dataset.name;
    document.getElementById('editClassForm').action = '/classes/edit/' + btn.dataset.id;
  });
  document.getElementById('deleteClassModal').addEventListener('show.bs.modal', e => {
    const btn = e.relatedTarget;
    document.getElementById('deleteClassName').textContent = btn.dataset.name;
    document.getElementById('deleteClassForm').action = '/classes/delete/' + btn.dataset.id;
  });
</script>

<!-- Auto-dismiss + URL clean -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => {
      document.querySelectorAll('.alert').forEach(el =>
        bootstrap.Alert.getOrCreateInstance(el).close()
      );
    }, 3000);
    history.replaceState({}, document.title, location.pathname);
  });
</script>

</body>
</html>
