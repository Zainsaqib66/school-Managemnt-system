<%- include('partials/head',{ title:'All Students' }) %>
<%- include('partials/nav') %>

<div class="container my-5">
  <% if (message) { %>
    <div class="alert alert-success"><%= message %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Students</h2>
    <a href="/students/add" class="btn btn-success">
      <i class="bi bi-person-plus-fill me-1"></i> Add Student
    </a>
  </div>

  <table class="table table-striped">
    <thead>
      <tr>
        <th>#</th>
        <th>Name</th>
        <th>Roll #</th>
        <th>Class</th>
        <th>Section</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% students.forEach((s,i) => { %>
        <tr>
          <td><%= i+1 %></td>
          <td><%= s.name %></td>
          <td><%= s.rollNumber %></td>
          <td><%= s.className %></td>
          <td><%= s.section %></td>
          <td>
            <a href="/students/view/<%= s._id %>" class="btn btn-sm btn-info">View</a>
            <a href="/students/edit/<%= s._id %>" class="btn btn-sm btn-warning">Edit</a>
            <form action="/students/delete/<%= s._id %>" method="POST" class="d-inline"
                  onsubmit="return confirm('Delete this student?');">
              <button class="btn btn-sm btn-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
</body>
</html>
