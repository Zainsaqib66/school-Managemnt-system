<%- include('partials/head', { title: 'Students in ' + className }) %>
<%- include('partials/nav') %>

<div class="container my-4">
  <div class="card mx-auto shadow" style="max-width:800px;">
    <div class="card-body">

      <!-- SUCCESS -->
      <% if (typeof message !== 'undefined' && message) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <!-- ERROR -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Class: <%= className %></h3>
        <a href="/students/add?className=<%= encodeURIComponent(className) %>"
           class="btn btn-primary">Add Student</a>
      </div>

      <% if (students.length === 0) { %>
        <p class="text-center text-muted">No students in this class.</p>
      <% } else { %>
        <table class="table table-striped table-hover">
          <thead class="table-dark">
            <tr>
              <th>Name</th>
              <th>Roll #</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% students.forEach(s => { %>
              <tr>
                <td><%= s.name %></td>
                <td><%= s.rollNumber %></td>
                <td>
                  <a href="/students/view/<%= s._id %>"
                     class="btn btn-sm btn-info me-1">View</a>
                  <a href="/students/edit/<%= s._id %>?fromClass=<%= encodeURIComponent(className) %>"
                     class="btn btn-sm btn-warning me-1">Edit</a>
                  <button
                    class="btn btn-sm btn-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#deleteModal"
                    data-student-id="<%= s._id %>"
                    data-student-name="<%= s.name %>">
                    Delete
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>

      <a href="/classes" class="btn btn-secondary mt-3">← Back to Classes</a>
    </div>
  </div>
</div>

<!-- DELETE STUDENT MODAL -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form method="POST" id="deleteForm">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Delete Student</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" id="deleteMessage"></div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            Cancel
          </button>
          <button type="submit" class="btn btn-danger">Yes, Delete</button>
        </div>
      </div>
    </form>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  const deleteModal = document.getElementById('deleteModal');
  deleteModal.addEventListener('show.bs.modal', function (e) {
    const btn  = e.relatedTarget;
    const id   = btn.getAttribute('data-student-id');
    const name = btn.getAttribute('data-student-name');
    this.querySelector('#deleteForm').action      = '/students/delete/' + id;
    this.querySelector('#deleteMessage').innerHTML =
      `Delete <strong>${name}</strong>?`;
  });
</script>
</body>
</html>
